generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())
  enquiries    Enquiry[] @relation("EnquiryCreator")
  quotations   Quotation[] @relation("QuotationCreator")
  createdOrders SalesOrder[] @relation("OrderCreator")
}

model Customer {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String   @unique
  city          String
  createdAt     DateTime @default(now())
  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  @@index([companyName])
}

model Product {
  id          String   @id @default(cuid())
  productCode String   @unique
  name        String
  category    String
  unit        String
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  inventory   Inventory?
  enquiryItems EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems SalesOrderItem[]
  dispatchItems DispatchItem[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  damagedQuantity  Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId])
}

model Enquiry {
  id            String        @id @default(cuid())
  enquiryNumber String        @unique
  customerId    String
  enquiryDate   DateTime
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdById   String
  createdAt     DateTime      @default(now())
  customer      Customer      @relation(fields: [customerId], references: [id])
  createdBy     User          @relation("EnquiryCreator", fields: [createdById], references: [id])
  items         EnquiryItem[]
  quotations    Quotation[]
  @@index([customerId, status])
}

model EnquiryItem {
  id        String  @id @default(cuid())
  enquiryId String
  productId String
  quantity  Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  @@unique([enquiryId, productId])
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  enquiryId       String
  customerId      String
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  grandTotal      Decimal         @db.Decimal(14, 2)
  createdById     String
  createdAt       DateTime        @default(now())
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  createdBy       User            @relation("QuotationCreator", fields: [createdById], references: [id])
  items           QuotationItem[]
  salesOrder      SalesOrder?
  @@index([enquiryId, status])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  productId    String
  quantity     Int
  unitPrice    Decimal   @db.Decimal(12, 2)
  discountPct  Decimal   @default(0) @db.Decimal(5, 2)
  gstPct       Decimal   @default(18) @db.Decimal(5, 2)
  lineAmount   Decimal   @db.Decimal(14, 2)
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])
  @@unique([quotationId, productId])
}

model SalesOrder {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  quotationId     String      @unique
  customerId      String
  orderDate       DateTime    @default(now())
  totalAmount     Decimal     @db.Decimal(14, 2)
  status          OrderStatus @default(PENDING)
  createdById     String
  createdAt       DateTime    @default(now())
  quotation       Quotation   @relation(fields: [quotationId], references: [id])
  customer        Customer    @relation(fields: [customerId], references: [id])
  createdBy       User        @relation("OrderCreator", fields: [createdById], references: [id])
  items           SalesOrderItem[]
  dispatches      Dispatch[]
  @@index([customerId, status])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineAmount   Decimal    @db.Decimal(14, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
  dispatchItems DispatchItem[]
  @@unique([salesOrderId, productId])
}

model Dispatch {
  id             String     @id @default(cuid())
  dispatchNumber String     @unique
  salesOrderId   String
  dispatchDate   DateTime   @default(now())
  vehicleNumber  String
  driverName     String
  createdAt      DateTime   @default(now())
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  items          DispatchItem[]
  @@index([salesOrderId])
}

model DispatchItem {
  id               String         @id @default(cuid())
  dispatchId       String
  salesOrderItemId String
  productId        String
  quantity         Int
  dispatch         Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  @@unique([dispatchId, salesOrderItemId])
}
